{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/build",
            "!**/dist",
            "!**/dist-*", // the e2e bundle (client/dist-e2e) and any other dist variant
            "!**/coverage",
            "!**/test-results", // exclude common output directories
            "!**/src/routeTree.gen.ts" // exclude generated route tree file (See https://tanstack.com/router/latest)
        ]
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            // Flags ternary max/min over ISO timestamps, Dates and ids too, where Math.max/min would yield NaN or numbers.
            "complexity": { "useMathMinMax": "off" }
        }
    },
    "overrides": [
        {
            // Playwright's locator.innerText() is not DOM Node.innerText; its textContent() drops layout line breaks.
            "includes": ["e2e/**"],
            "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
        }
    ],
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 160
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all"
        }
    },
    // Biome 2.6 started formatting Markdown and YAML by default; docs and workflows are hand-formatted.
    "markdown": { "formatter": { "enabled": false } },
    "yaml": { "formatter": { "enabled": false } },
    "css": {
        "parser": {
            "cssModules": true
        }
    }
}
