# Copy to `.env` and fill in what you need. Every key is optional in local dev unless noted;
# see README.md § Environment Variables for defaults and docs/gcp-deploy-plan.md for the deployed
# inventory (GitHub environment secrets/variables → Cloud Run env vars).

# Server
PORT=4000
NODE_ENV=development

# Database (required)
MONGO_DB_URL=mongodb://localhost:27017
MONGO_DB_NAME=gtd_dev

# Better Auth — session signing + OAuth callbacks. Production refuses to boot without the secret.
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
CLIENT_URL=http://localhost:4173

# OAuth providers
GOOGLE_OAUTH_APP_CLIENT_ID=
GOOGLE_OAUTH_APP_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Calendar integration
CALENDAR_ENCRYPTION_KEY=          # 128 hex chars (AES-256 key for stored OAuth tokens)
CALENDAR_WEBHOOK_URL=             # public URL Google pushes to, e.g. https://<tunnel>/calendar/webhooks/google

# Cloud Scheduler jobs send this as the `x-cron-secret` header (webhook renewal, brief sweep)
CRON_SECRET=

# Web Push (VAPID) — `npx web-push generate-vapid-keys`; push is disabled unless all three are set
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Outbound webhook delivery worker — on by default outside production; production opts in with `true`
WEBHOOKS_ENABLED=

# Claude assist + item briefs
ANTHROPIC_API_KEY=
EXECUTE_TOKEN_SIGNING_KEY=        # 32+ random chars; production throws without it when minting execute tokens
CLAUDE_ASSIST_DAILY_COST_CAP_USD=1
