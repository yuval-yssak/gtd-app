{
    "name": "mcp-server",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Local stdio MCP server that exposes the GTD /v1 public API as MCP tools",
    "scripts": {
        "build": "tsrs -p tsconfig.build.json",
        "prepare": "tsrs -p tsconfig.build.json",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "lint": "biome check",
        "lint:fix": "biome check . --write",
        "typecheck": "tsrs --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "bin": {
        "gtd-mcp": "./dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "zod": "^4.6.7",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@types/node": "^26.6.5",
        "tsrs": "0.20.0-ts7.1.0-beta",
        "tsx": "latest",
        "typescript": "latest",
        "vitest": "latest"
    },
    "engines": {
        "node": "^22 || >=24"
    }
}
