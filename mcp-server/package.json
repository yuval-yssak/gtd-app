{
    "name": "mcp-server",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Local stdio MCP server that exposes the GTD /v1 public API as MCP tools",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "lint": "biome check",
        "lint:fix": "biome check . --write",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "bin": {
        "gtd-mcp": "./dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.4",
        "zod": "^4.4.3",
        "zod-to-json-schema": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "tsx": "latest",
        "typescript": "latest",
        "vitest": "latest"
    },
    "engines": {
        "node": "^22 || >=24"
    }
}
