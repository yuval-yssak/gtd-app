{
    "permissions": {
        "allow": [
            "Bash(mongosh:*)",
            "Bash(op read op://Private/Database - GTD staging/*)",
            "Bash(op item get Database - GTD staging:*)"
        ]
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash -c 'bash \"$(git rev-parse --show-toplevel)/scripts/post-change-checks.sh\"'"
                    }
                ]
            }
        ]
    }
}
