{
    "name": "getting-things-done",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite build --watch\" \"vite preview\"",
        "generate-typed-css-modules": "find ./src -name '*.css.d.ts' -delete && npx typed-css-modules src && npm run lint:fix",
        "build": "npm run generate-typed-css-modules && vite build && tsc -b",
        "lint": "biome check && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:fix": "biome check . --write",
        "lint:fix:unsafe": "biome check --write --unsafe",
        "typecheck": "tsc -b --noEmit",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fontsource/inter": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@tanstack/react-router": "^1.170.46",
        "better-auth": "^1.7.12",
        "canvas-confetti": "^1.9.4",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "fractional-indexing": "^4.0.0",
        "idb": "^8.0.4",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "rrule": "^2.8.1",
        "virtua": "^0.53.6"
    },
    "imports": {
        "#api/syncClient": {
            "test": "./src/api/syncClient.mock.ts",
            "default": "./src/api/syncClient.ts"
        },
        "#api/syncApi": {
            "test": "./src/api/syncApi.mock.ts",
            "default": "./src/api/syncApi.ts"
        },
        "#api/accountApi": {
            "test": "./src/api/accountApi.mock.ts",
            "default": "./src/api/accountApi.ts"
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@storybook/addon-a11y": "^10.6.3",
        "@storybook/react-vite": "^10.6.3",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.48",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "concurrently": "^10.0.6",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "storybook": "^10.6.3",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typed-css-modules": "^0.9.1",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "wrangler": "^4.152.0"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5",
        "undici": "^7.30.1"
    }
}
